# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection (used by the app and by compose.yaml)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=KazalisteDb
PG_USER=postgres
PG_PASSWORD=change_me

# HikariCP connection pool
POOL_MAXIMUM_POOL_SIZE=10
POOL_MINIMUM_IDLE=2
POOL_CONNECTION_TIMEOUT=30000
POOL_IDLE_TIMEOUT=600000
POOL_MAX_LIFETIME=1800000

# pgAdmin login (used by compose.yaml)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
